# Private admin access
ADMIN_SALES_USERNAME=mfoniso
ADMIN_SALES_PASSWORD=

# ThinkJackson AI Runtime (server-side only) — one shared runtime for every
# AI call on the site (Scout, Researcher, and the founder's daily mission
# generator all go through lib/ai/runtime.ts's generate()). Provider choice
# lives in lib/ai/model-registry.ts, not scattered env vars per feature.
#
# AI_RUNTIME_MODE: FREE_ONLY (default) | FREE_PREFERRED | PAID_ALLOWED.
# In FREE_ONLY, paid providers (Grok, OpenAI) are never called even if
# their keys are set below — the mode is the one switch cost safety
# depends on. Optional ceilings: AI_MAX_REQUESTS_PER_DAY (default 200),
# AI_DAILY_BUDGET_USD (default 5, only enforced in PAID_ALLOWED).
AI_RUNTIME_MODE=FREE_ONLY
AI_MAX_REQUESTS_PER_DAY=
AI_DAILY_BUDGET_USD=

# Free-tier providers, tried in this order:
# GEMINI_API_KEY: free tier, no card required, at aistudio.google.com/apikey.
# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN: 10,000 free neurons/day, at
# dash.cloudflare.com — no Cloudflare hosting needed, called over REST.
# OPENROUTER_API_KEY: free ":free" models, at openrouter.ai/keys — OpenRouter's
# own docs call these "usually not suitable for production," so this is
# wired in as a last-resort free fallback, not a primary dependency.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Paid fallbacks — only ever called in FREE_PREFERRED/PAID_ALLOWED mode.
# XAI_API_KEY: requires a funded account at console.x.ai (no free tier).
XAI_API_KEY=
XAI_MODEL=grok-4.6
OPENAI_API_KEY=
AGENT_MODEL=

# Autonomous Scout (server-side only) — a daily cron (see vercel.json) that
# searches the open web for one research territory per day via Tavily and
# runs new results through the same Scout/Researcher/Librarian pipeline as
# manual discovery. Ships disabled: AUTONOMOUS_SCOUT_ENABLED must be set to
# the literal string "true" to do anything. TAVILY_API_KEY: free tier, no
# card required, at app.tavily.com. CRON_SECRET: any random string of 16+
# characters — Vercel sends it back as the cron request's own Authorization
# header, so the route can verify the request actually came from Vercel.
AUTONOMOUS_SCOUT_ENABLED=false
TAVILY_API_KEY=
CRON_SECRET=

# Supabase (server-side service role only). Used for execution OS
# persistence, sales/investor leads (public.sales_leads), and newsletter
# subscribers (public.newsletter_subscribers). Use the "service_role"
# secret key from Project Settings -> API -> Project API keys, not the
# anon/publishable key — every table these write to has RLS locked to
# service_role only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
