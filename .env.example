# Private admin access
ADMIN_SALES_USERNAME=mfoniso
ADMIN_SALES_PASSWORD=

# AI mission generation (server-side only) — the founder execution OS
# always uses OpenAI directly regardless of the research-pipeline vars below.
OPENAI_API_KEY=
AI_MISSION_MODEL=gpt-5.6-luna

# Research pipeline agents (Scout/Researcher, server-side only). Tried in
# order — Gemini, then Grok, then OpenAI — with automatic failover to the
# next configured provider if one call fails (rate limit, transient 5xx).
# GEMINI_API_KEY: free tier available, no card required, at
# aistudio.google.com/apikey.
# XAI_API_KEY: requires a funded account at console.x.ai (no free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
AGENT_MODEL=

# Autonomous Scout (server-side only) — a daily cron (see vercel.json) that
# searches the open web for one research territory per day via Tavily and
# runs new results through the same Scout/Researcher/Librarian pipeline as
# manual discovery. Ships disabled: AUTONOMOUS_SCOUT_ENABLED must be set to
# the literal string "true" to do anything. TAVILY_API_KEY: free tier, no
# card required, at app.tavily.com. CRON_SECRET: any random string of 16+
# characters — Vercel sends it back as the cron request's own Authorization
# header, so the route can verify the request actually came from Vercel.
AUTONOMOUS_SCOUT_ENABLED=false
TAVILY_API_KEY=
CRON_SECRET=

# Supabase (server-side service role only). Used for execution OS
# persistence, sales/investor leads (public.sales_leads), and newsletter
# subscribers (public.newsletter_subscribers). Use the "service_role"
# secret key from Project Settings -> API -> Project API keys, not the
# anon/publishable key — every table these write to has RLS locked to
# service_role only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
